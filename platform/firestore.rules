rules_version = '2';

// The browser never reads or writes Firestore directly: every request goes
// through this app's API, which uses the Firebase Admin SDK (rules don't apply
// to it) and enforces sign-in, roles and per-business isolation itself.
// Deny all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
