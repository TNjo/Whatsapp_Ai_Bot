# ---------------------------------------------------------------------------
# WhatsApp AI Business Bot — copy to .env.local and fill in.
# Never commit real values. Nothing here is ever sent to the browser.
# ---------------------------------------------------------------------------

# Public URL of this app (used for the webhook URL shown in the dashboard).
APP_URL=http://localhost:3000

# --- Firebase (Cloud Firestore) -------------------------------------------
# The server talks to Firestore with the Firebase Admin SDK. Create a service
# account key: Firebase console → Project settings → Service accounts →
# Generate new private key. Then EITHER paste the whole JSON (or base64 of it):
FIREBASE_SERVICE_ACCOUNT=
# OR set the three fields separately (keep the \n line breaks in the key):
FIREBASE_PROJECT_ID=business-automations-1e2b2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# On Google Cloud (Cloud Run / App Hosting) the runtime's default credentials
# are used automatically when only FIREBASE_PROJECT_ID is set.
# Optional: a named database instead of "(default)".
FIRESTORE_DATABASE_ID=
# Local development against the Firestore emulator (requires Java + firebase-tools):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Throwaway in-memory database (data is lost on restart) — for demos only:
# FIREBASE_USE_MEMORY=true

# 32 random bytes, base64 — encrypts stored WhatsApp tokens and AI keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Meta / WhatsApp Cloud API ---------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value in the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Embedded Signup configuration ID (Meta app → WhatsApp → Embedded Signup / Facebook Login for Business).
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v23.0

# Optional: single-business credentials (System User token) for the "Use server credentials" connect option.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- AI ----------------------------------------------------------------------
# Default AI for businesses that haven't added their own key in Bot settings.
# AI_PROVIDER: claude | openai | gemini | groq | custom (inferred from the key when empty)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# debug | info (default) | silent
LOG_LEVEL=info
